{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://e1.local/schemas/recognize_score.input.json",
  "title": "recognize_score input",
  "type": "object",
  "required": ["image_path"],
  "additionalProperties": false,
  "properties": {
    "image_path": {
      "type": "string",
      "description": "谱面图片绝对路径（PNG/JPG/TIFF/BMP）。"
    },
    "output_dir": {
      "type": "string",
      "description": "产物目录；缺省为 <install-dir>/samples/recognize_score。"
    }
  }
}
