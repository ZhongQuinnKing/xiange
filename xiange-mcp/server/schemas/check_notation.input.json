{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://e1.local/schemas/check_notation.input.json",
  "title": "check_notation input",
  "type": "object",
  "required": ["score_path"],
  "additionalProperties": false,
  "properties": {
    "score_path": {
      "type": "string",
      "description": "未压缩 MusicXML 绝对路径（.musicxml/.xml）。"
    },
    "output_dir": {
      "type": "string",
      "description": "产物目录；缺省为 <install-dir>/samples/check_notation。"
    }
  }
}
